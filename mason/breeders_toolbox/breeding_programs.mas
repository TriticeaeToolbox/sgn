
<%args>
$breeding_programs
$user => undef
</%args>

<%perl>
my $curator_flag = 0;
if ($user && $user->check_roles("curator")) {
    $curator_flag = 1;
}
</%perl>

<& /page/page_title.mas, title=>"Manage Breeding Programs" &>

<div class="container-fluid">
<hr>

<table class="table table-condensed table-striped table-hover">
  <thead>
    <tr>

    <%perl>
      if ($curator_flag) { print "<th>Name</th><th>Info</th><th>Contact</th><th>Edit</th><th>Delete</th>"; }
      else { print "<th>Name</th><th>Info</th>"; }
    </%perl>

    </tr>
  </thead>
  <tbody>

    <%perl>
      foreach my $bp (@$breeding_programs) {
        print "<tr><td><b><a href=\"/breeders/program/$bp->[0]\" >$bp->[1]</a></b></td><td>$bp->[2]</td>";
        if ($curator_flag) {
          print "<td>";
          print "$bp->[4]" if defined $bp->[4] && $bp->[4] ne '';
          print " &lt;<a href='mailto:" . $bp->[5] . "'>" . $bp->[5] . "</a>&gt;" if defined $bp->[5] && $bp->[5] ne '';
          print " 🔔" if $bp->[6];
          print "</td>";
          print "<td><a title=\"edit this breeding program\" id=\"edit_breeding_program_link\_".$bp->[1]."\" href=\"javascript:edit_breeding_program($bp->[0], '$bp->[1]', '$bp->[2]', '$bp->[4]', '$bp->[5]', " . ($bp->[6] ? 'true' : 'false') . ")\" ><span class=\"glyphicon glyphicon-pencil\"></span></a></td>";
          print "<td><a title=\"delete this breeding program\" id=\"delete_breeding_program_link\_".$bp->[1]."\" href=\"javascript:delete_breeding_program($bp->[0],'$bp->[1]')\" ><font color=\"red\">X</font></a></td>";
        }
        print "</tr>";
      }
    </%perl>

  </tbody>
</table>

<br/>
<button type="button" class="btn btn-primary" name="new_breeding_program_link" id="new_breeding_program_link">Add New Program</button>

</div>

<!-- Modal Dialogs Below Here -->

<div class="modal fade" id="store_breeding_program_dialog" name="store_breeding_program_dialog" tabindex="-1" role="dialog" aria-labelledby="storeBreedingProgramDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addBreedingProgramDialog">Store Breeding Program Details</h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
          <form class="form-horizontal" role="form" name="store_breeding_program_form" id="store_breeding_program_form">
            <div class="form-group" id="store_breeding_program_id" style="display: none"></div>
            <div class="form-group">
              <label class="col-sm-3 control-label">Name: </label>
              <div class="col-sm-9">
                <input class="form-control" name="store_breeding_program_name" id="store_breeding_program_name" type="text" />
                <small><em>Required</em></small>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label">Description: </label>
              <div class="col-sm-9">
                <input class="form-control" name="store_breeding_program_desc" id="store_breeding_program_desc" type="text" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label">Contact Name: </label>
              <div class="col-sm-9">
                <input class="form-control" name="store_breeding_program_contact_name" id="store_breeding_program_contact_name" type="text" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label">Contact Email: </label>
              <div class="col-sm-9">
                <input class="form-control" name="store_breeding_program_contact_email" id="store_breeding_program_contact_email" type="text" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label">Alert Contact: </label>
              <div class="col-sm-9" style="display: flex; align-items: center; gap: 15px">
                <input name="store_breeding_program_contact_alert" id="store_breeding_program_contact_alert" type="checkbox" />
                <em>Send an email alert to this contact when files are submitted to this breeding program</em>
              </div>
          </form>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" name="store_breeding_program_submit" id="store_breeding_program_submit">Store Breeding Program Details</button>
      </div>
    </div>
  </div>
</div>


<script>

jQuery(document).ready(function() {

  jQuery("button#new_breeding_program_link").click( function(event) {
      event.preventDefault();
      edit_breeding_program('', '', '', '', '', false);
  });

  jQuery('#store_breeding_program_submit').click( function(event) {
      event.preventDefault();
      var id= jQuery('#store_breeding_program_id').val();
      var name = jQuery('#store_breeding_program_name').val().trim();
      var desc = jQuery('#store_breeding_program_desc').val();
      var contact_name = jQuery('#store_breeding_program_contact_name').val().trim();
      var contact_email = jQuery('#store_breeding_program_contact_email').val().trim();
      var contact_alert = jQuery('#store_breeding_program_contact_alert').is(':checked');

      if (name === '') {
          alert("Please enter a name for the breeding program.");
          return;
      }
      if (!!contact_alert && (!contact_email || contact_email === '')) {
          alert("Please enter a contact email to send alerts to.");
          return;
      }

      jQuery.ajax({
          type: 'POST',
          url: '/breeders/program/store',
          data: { 'id': id, 'name': name, 'desc': desc, 'contact_name': contact_name, 'contact_email': contact_email, 'contact_alert': contact_alert },
          beforeSend: function()  { jQuery('#working').dialog("open") },
          success: function(response) {
              if (response.error) { alert(response.error); }
              else {
                  alert(response.success);
              }
              jQuery('#working').dialog("close");
              location.reload();
          },
          error: function(response) {
              alert("An error occurred."+ response.responseText);
              jQuery('#working').dialog("close");
          }
      });
      jQuery("#store_breeding_program_dialog").modal("hide");
  });


});

function edit_breeding_program(program_id, program_name, program_description, contact_name, contact_email, contact_alert) {
    console.log("Editing breeding program: ", program_id, program_name, program_description, contact_name, contact_email, contact_alert);
    jQuery('#store_breeding_program_id').val(program_id);
    jQuery('#store_breeding_program_name').val(program_name);
    jQuery('#store_breeding_program_desc').val(program_description);
    jQuery('#store_breeding_program_contact_name').val(contact_name);
    jQuery('#store_breeding_program_contact_email').val(contact_email);
    jQuery('#store_breeding_program_contact_alert').prop('checked', !!contact_alert);
    jQuery("#store_breeding_program_dialog").modal("show");
}


function delete_breeding_program(program_id, program_name) {
   if (confirm("Delete breeding program "+program_name+"? The associated trials will not be deleted, but be listed under 'Other'")) {
      jQuery.ajax( {
        url: '/breeders/program/delete/'+program_id,
        error: function(response) {
        alert("An error occurred.");
      },
      success: function(response) {
        if (response.error) {
          alert(response.error);
        }
        else {
          location.reload();
        }
      }
    });
  }
}

</script>
